# ─── .env.docker.example ──────────────────────────────────────────────────────
# Copy to .env.docker and fill in values before running docker compose.
# This file is for Docker Compose only. The backend/.env is for local dev.
# NEVER commit .env.docker to git — add it to .gitignore.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=arbeitszeit_pro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Backend port (host machine) ────────────────────────────────────────────────
BACKEND_PORT=3000

# ── App ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX

# ── Email ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key
SMTP_FROM=no-reply@yourdomain.com

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_PRICE_ID_EMPLOYER_MONTHLY=price_...
STRIPE_PRICE_ID_EMPLOYER_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
