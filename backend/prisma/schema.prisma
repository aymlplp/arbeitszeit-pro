generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EMPLOYER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String?
  passwordHash  String
  role          Role         @default(USER)
  plan          Plan         @default(FREE)
  stripeCustId  String?      @unique

  // Employer relationship
  employerId    String?
  employerCode  String?      @unique
  employer      User?        @relation("EmployerWorkers", fields: [employerId], references: [id], onDelete: SetNull)
  workers       User[]       @relation("EmployerWorkers")

  // Email verification
  emailVerified           Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpiry  DateTime?

  // Password reset
  resetToken              String?   @unique
  resetTokenExpiry        DateTime?

  refreshTokenId String?
  yearData      YearData[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model YearData {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year          Int
  data          Json     @default("{}")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, year])
  @@index([userId])
}
